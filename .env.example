# ========================================================
# NETRANI SCUBA DIVE - ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. RESEND CONFIGURATION (Primary & Recommended)
# --------------------------------------------------------
# Get your free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# The sender address displayed on outgoing emails:
# - During testing / sandbox (without verified domain): use 'Netrani Scuba Dive <onboarding@resend.dev>'
# - In production (once custom domain is verified in Resend): use 'Netrani Scuba Dive <bookings@murudeshwarscubadive.in>'
RESEND_FROM=Netrani Scuba Dive <onboarding@resend.dev>

# The recipient email address for form booking notifications:
# Note: In Resend sandbox mode, emails can only be delivered to your registered Resend account email.
# When your domain is verified, you can send to any email.
RESEND_TO=murudeshwar.scuba.dive@gmail.com
BOOKING_NOTIFICATION_EMAIL=murudeshwar.scuba.dive@gmail.com

# Optional: Send a confirmation copy to the customer's email address
# (Set to true once your custom domain is verified in Resend)
SEND_CUSTOMER_CONFIRMATION=false

# --------------------------------------------------------
# 2. SMTP FALLBACK CONFIGURATION (Optional fallback)
# --------------------------------------------------------
# Used only if RESEND_API_KEY is not provided.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Netrani Scuba Dive Bookings" <murudeshwar.scuba.dive@gmail.com>
