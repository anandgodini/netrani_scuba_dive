# ========================================================
# NETRANI SCUBA DIVE - ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Booking Notification Recipient
# The email address that receives new customer booking enquiry notifications.
# If unset, defaults to: murudeshwar.scuba.dive@gmail.com
BOOKING_NOTIFICATION_EMAIL=murudeshwar.scuba.dive@gmail.com

# 2. SMTP Server Configuration
# Provide standard SMTP credentials (e.g. Gmail, Hostinger, Zoho, AWS SES, Resend, SendGrid)
# To use Gmail:
#   - SMTP_HOST=smtp.gmail.com
#   - SMTP_PORT=587
#   - SMTP_SECURE=false
#   - SMTP_USER=your-email@gmail.com
#   - SMTP_PASS=your-16-digit-app-password (generated in Google Account Security -> App Passwords)
#
# To use Hostinger / cPanel:
#   - SMTP_HOST=smtp.hostinger.com
#   - SMTP_PORT=465
#   - SMTP_SECURE=true
#   - SMTP_USER=bookings@murudeshwarscubadive.in
#   - SMTP_PASS=your-mailbox-password
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Netrani Scuba Dive Bookings" <murudeshwar.scuba.dive@gmail.com>
